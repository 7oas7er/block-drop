# CloudFront distribution domain names (from envs/*/ terraform output distribution_domain_name).
prod_cloudfront_domain_name = "d111111abcdef8.cloudfront.net"
stg_cloudfront_domain_name  = "d222222abcdef8.cloudfront.net"

# Must match the matching AWS env origin_verify_secret (never commit real values).
stg_origin_verify_secret  = "replace-with-a-long-random-secret"
prod_origin_verify_secret = "replace-with-a-different-long-random-secret"

# After apply, put output zone_id into both GitHub Environments as CLOUDFLARE_ZONE_ID,
# and add a CLOUDFLARE_API_TOKEN secret with Zone.Cache Purge (plus Zone.Read) for deploys.
#
# Terraform API token also needs Zone → Cache Rules → Edit, Zone → WAF → Edit
# (rate limiting), Zone → Single Redirect → Edit (www/apex → blockdrop),
# Transform Rules, DNS, and Zone Settings as used by this root.
#
# Optional Free-compatible /api/scores rate limit overrides (defaults: 20 req / 10s / IP):
# api_rate_limit_period_seconds              = 10
# api_rate_limit_requests_per_period         = 20
# api_rate_limit_mitigation_timeout_seconds  = 10
