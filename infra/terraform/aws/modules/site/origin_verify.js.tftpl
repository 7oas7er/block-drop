function handler(event) {
  var request = event.request;
  var headers = request.headers;
  var expected = ${jsonencode(origin_verify_secret)};

  if (!headers["x-origin-verify"] || headers["x-origin-verify"].value !== expected) {
    return {
      statusCode: 403,
      statusDescription: "Forbidden",
      headers: {
        "content-type": { value: "text/plain" }
      },
      body: "Forbidden"
    };
  }

  return request;
}
