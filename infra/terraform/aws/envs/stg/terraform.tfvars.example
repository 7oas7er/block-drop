aws_region  = "eu-north-1"
aws_profile = "7oas7er"

# ACM certificate in us-east-1 for blockdrop-stg.7oas7er.com.
site_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"

# Must match Cloudflare stg_origin_verify_secret (never commit the real value).
origin_verify_secret = "replace-with-a-long-random-secret"
